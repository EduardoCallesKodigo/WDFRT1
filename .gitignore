# ---------------------------------------------
# 1. SISTEMAS OPERATIVOS
# ---------------------------------------------

# macOS
**/.DS_Store
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encrypt
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ---------------------------------------------
# 2. EDITORES Y ENTORNOS DE DESARROLLO (IDEs)
# ---------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ---------------------------------------------
# 3. NODE, REACT Y VITE (Dependencias y Builds)
# ---------------------------------------------

# Dependencias (nunca se suben, pesan cientos de MB)
node_modules/
.pnp
.pnp.js

# Carpeta de compilación/producción generada por Vite
dist/
dist-ssr/
build/

# Logs de error y depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variables de entorno con claves secretas
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Excepción opcional: puedes dejar visible una plantilla de ejemplo
# !.env.example

# Cachés de Vite y herramientas de testing
.eslintcache
.stylelintcache
coverage/
